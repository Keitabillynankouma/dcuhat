# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=changez-cette-cle-en-production
DJANGO_DEBUG=0
ALLOWED_HOSTS=dcuhat.lambayin.gov,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Base de donnees (PostgreSQL + PostGIS) -------------------------------
POSTGRES_DB=dcuhat
POSTGRES_USER=dcuhat
POSTGRES_PASSWORD=changez-ce-mot-de-passe
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Stockage objet -------------------------------------------------------
OBJECT_STORAGE_BACKEND=s3        # local | s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=dcuhat
S3_SECRET_KEY=changez-ce-secret
S3_BUCKET=dcuhat
S3_PRESIGNED_TTL=300

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://redis:6379/0
USE_REDIS_CACHE=1

# --- Politiques -----------------------------------------------------------
MAX_UPLOAD_SIZE_MB=2048
UPLOAD_CHUNK_SIZE_MB=5
SIMPLE_UPLOAD_MAX_MB=10
DEFAULT_SERVICE_QUOTA_GB=50
TRASH_RETENTION_DAYS=30
VERSION_RETENTION_COUNT=20
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Geospatial -----------------------------------------------------------
GEO_DEFAULT_SRIDS=4326,32628,32629
GEO_SIMPLIFY_TOLERANCE=0.00005
GEO_MAX_FEATURES_INLINE=5000
